AQUA_SESSION_SECRET=replace-with-a-long-random-secret
# Dedicated evidence key: retain this through session-secret rotation.
# For an existing deployment, initialize it to the PREVIOUS AQUA_SESSION_SECRET.
AQUA_AUDIT_SIGNING_KEY=replace-with-an-independent-evidence-secret
# Optional comma-separated retired audit keys, used for verification only.
AQUA_AUDIT_PREVIOUS_KEYS=
AQUA_ADMIN_USERNAME=admin
AQUA_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AQUA_USER_USERNAME=user
AQUA_USER_PASSWORD=replace-with-a-strong-user-password

# Local development only. Production uses a linked PRIVATE Vercel Blob store.
AQUA_AUDIT_DIR=test-results/local-store
# Optional independent local authentication store; defaults to AQUA_AUDIT_DIR.
AQUA_SECURITY_DIR=test-results/local-store
# Full Git revision of the released source (set by release process).
AQUA_SOURCE_REVISION=
# BLOB_READ_WRITE_TOKEN is injected by the private Blob project integration.

# Optional. Without this key, Copilot uses the built-in keyword fallback.
OPENAI_API_KEY=
OPENAI_RAG_MODEL=gpt-5.6-sol
